# Скопируйте в .env и заполните (файл .env не коммитится)
URALIA_DB_PASSWORD=change-me-long-random
URALIA_JWT_SECRET=change-me-64-random-chars
URALIA_ENV=dev
# 8000 = открыт наружу; 127.0.0.1:8000 = только для Caddy/nginx на этом же сервере
URALIA_API_BIND=8000
# Панель владельца /admin (минимум 24 символа). Пусто = панель выключена
URALIA_ADMIN_TOKEN=
# Реальные платежи: 0 = запрещены на уровне развёртывания (тестовый режим)
URALIA_PAYMENTS_COMMERCIAL_ALLOWED=0
